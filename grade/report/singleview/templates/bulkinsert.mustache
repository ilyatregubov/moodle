{{!
    @template core_message/send_bulk_message
    Template for the send bulk message modal.
    Context variables required for this template:
      None
    Example context (json):
    {
    }
}}
<form>
    <p>
        {{#str}}bulkchoice, gradereport_singleview{{/str}}
    <div data-region="notification" class="pt-3 px-3" role="radiogroup" aria-labelledby="send-student-notifications-setting">
        <label class="form-check">
            <input class="form-check-input" type="radio" name="bulkinsert" value="1"/>
            {{#str}}all_grades, gradereport_singleview{{/str}}
        </label>
        <label class="form-check">
            <input class="form-check-input" type="radio" name="bulkinsert" value="0"/>
            {{#str}}blanks, gradereport_singleview{{/str}}
        </label>
    </div>
    </p>

    <h6>
        {{#str}}bulkinsertvalue, gradereport_singleview{{/str}}
    </h6>
    <input type="text" name="{{name}}" id="{{id}}" size="{{size}}" value="{{value}}" class="form-control text-ltr" {{#readonly}}readonly{{/readonly}}>

</form>
