{{!
    @template gradereport_singleview/page_toggler
}}
<div class="d-flex">
    <p class="my-auto mr-3 text-uppercase">{{#str}}viewby, gradereport_singleview{{/str}}</p>
    <div class="btn-group" role="group" aria-label="TODO">
        <a href="{{{userviewurl}}}"
           type="button"
           class="btn btn-outline-primary {{#userviewactive}}active{{/userviewactive}}"
           {{#userviewactive}}aria-pressed="true"{{/userviewactive}}
           {{^userviewactive}}aria-pressed="false"{{/userviewactive}}
        >
            {{#str}}users, gradereport_singleview{{/str}}
        </a>
        <a href="{{{gradeitemviewurl}}}"
           type="button"
           class="btn btn-outline-primary {{#gradeitemviewactive}}active{{/gradeitemviewactive}}"
           {{#gradeitemviewactive}}aria-pressed="true"{{/gradeitemviewactive}}
           {{^gradeitemviewactive}}aria-pressed="false"{{/gradeitemviewactive}}
        >
            {{#str}}gradeitems, gradereport_singleview{{/str}}
        </a>
    </div>
</div>
